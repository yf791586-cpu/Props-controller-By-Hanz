local function rememberName(id, lbl)
    nameLabels[id] = nameLabels[id] or {}
    table.insert(nameLabels[id], lbl)
    if currentId == id then
        lbl.TextColor3 = Theme.Accent
    end
end

local function paintPlaying()
    local live = {}
    for _, entry in ipairs(rowStrokes) do
        if entry.stroke.Parent then
            local on = entry.id == currentId
            entry.stroke.Color = on and Theme.Accent or Theme.Line
            entry.stroke.Transparency = on and 0 or 0.35
            table.insert(live, entry)
        end
    end
    rowStrokes = live
    for id, labels in pairs(nameLabels) do
        local fresh = {}
        for _, lbl in ipairs(labels) do
            if lbl.Parent then
                lbl.TextColor3 = (id == currentId) and Theme.Accent or Theme.Text
                table.insert(fresh, lbl)
            end
        end
        nameLabels[id] = fresh
    end
    for _, bar in ipairs(bars) do
        bar.BackgroundTransparency = currentId and 0 or 0.45
    end
end

local function setPlaying(id, title)
    currentId = id
    NowTitle.Text = title
    NowId.Text = "ID  " .. tostring(id)
    paintPlaying()
end

local function getRemote()
    local folder = ReplicatedStorage:FindFirstChild("RE")
    local remote = folder and folder:FindFirstChild("1NoMoto1rVehicle1s")
    if not remote then
        NowTitle.Text = "Remote tidak ketemu"
        NowId.Text = "Masuk game dulu, lalu coba lagi"
        return nil
    end
    return remote
end

local function playId(rawId, title)
    local id = string.match(tostring(rawId or ""), "^%s*(.-)%s*$") or ""
    if id == "" then
        return
    end
    local remote = getRemote()
    if not remote then
        return
    end
    remote:FireServer("PickingScooterMusicText", id, nil, true)
    local known = nameById[id]
    setPlaying(id, title or known or "ID manual")
end

local function paintHeart(id)
    local list = heartButtons[tostring(id)]
    if not list then
        return
    end
    local on = isFav(id)
    for _, btn in ipairs(list) do
        if btn.Parent then
            btn.Text = on and "♥" or "♡"
            btn.TextColor3 = on and Theme.Accent or Theme.Muted
        end
    end
end

