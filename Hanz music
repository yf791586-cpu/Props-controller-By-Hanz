function renderFavs()
    for _, child in ipairs(favScroll:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    local query = string.lower(favSearch.Text or "")
    local entries = {}
    for id, flag in pairs(SavedFavorites) do
        if flag ~= nil and flag ~= false then
            local sid = tostring(id)
            local titleText = nameById[sid] or ("ID " .. sid)
            local key = string.lower(titleText .. " " .. sid)
            if query == "" or string.find(key, query, 1, true) then
                table.insert(entries, { id = sid, title = titleText, key = key })
            end
        end
    end
    table.sort(entries, function(a, b)
        return a.title:lower() < b.title:lower()
    end)

    -- drop destroyed heart buttons
    for id, list in pairs(heartButtons) do
        local fresh = {}
        for _, btn in ipairs(list) do
            if btn.Parent then
                table.insert(fresh, btn)
            end
        end
        heartButtons[id] = fresh
    end

    for order, entry in ipairs(entries) do
        local row, heart = createRow(favScroll, order, "♥", entry.title, entry.id, entry.id, function()
            playId(entry.id, entry.title)
        end)
        row.Visible = true
        bind(heart.MouseButton1Click, function()
            toggleFav(entry.id)
        end)
    end

    favEmpty.Visible = #entries == 0
    if query == "" then
        local total = 0
        for id, flag in pairs(SavedFavorites) do
            if flag ~= nil and flag ~= false then
                total = total + 1
            end
        end
        favCount.Text = tostring(total) .. " favorit"
    else
        favCount.Text = tostring(#entries) .. " hasil"
    end
    paintPlaying()
end

bind(favSearch:GetPropertyChangedSignal("Text"), renderFavs)
