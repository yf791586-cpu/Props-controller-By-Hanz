local Pages = {}
local activeTab = nil

local function CreateTab(tabName)
    local TabBtn = Instance.new("TextButton")
    TabBtn.Parent = Sidebar
    TabBtn.Size = UDim2.new(1, 0, 0, 30)
    TabBtn.BackgroundColor3 = Theme.ElementBg
    TabBtn.Text = tabName
    TabBtn.TextColor3 = Theme.TextDark
    TabBtn.Font = Enum.Font.GothamSemibold
    TabBtn.TextSize = 12
    TabBtn.AutoButtonColor = false
    Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)

    local Page = Instance.new("ScrollingFrame")
    Page.Parent = ContentArea
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.BackgroundTransparency = 1
    Page.ScrollBarThickness = 3
    Page.Visible = false
    Page.BorderSizePixel = 0

    local PageLayout = Instance.new("UIListLayout")
    PageLayout.Parent = Page
    PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    PageLayout.Padding = UDim.new(0, 8)

    local PagePadding = Instance.new("UIPadding")
    PagePadding.Parent = Page
    PagePadding.PaddingTop = UDim.new(0, 10)
    PagePadding.PaddingLeft = UDim.new(0, 10)
    PagePadding.PaddingRight = UDim.new(0, 10)

    -- Perbaikan Scroll Stuck
    PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        Page.CanvasSize = UDim2.new(0, 0, 0, PageLayout.AbsoluteContentSize.Y + 20)
    end)

    TabBtn.MouseButton1Click:Connect(function()
        for _, p in pairs(Pages) do
            p.Page.Visible = false
            TweenService:Create(p.Btn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.ElementBg, TextColor3 = Theme.TextDark}):Play()
        end
        Page.Visible = true
        TweenService:Create(TabBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Accent, TextColor3 = Theme.Text}):Play()
    end)

    if not activeTab then
        activeTab = true
        Page.Visible = true
        TabBtn.BackgroundColor3 = Theme.Accent
        TabBtn.TextColor3 = Theme.Text
    end

    table.insert(Pages, {Btn = TabBtn, Page = Page})
    local Elements = {}

    function Elements:CreateTextBox(placeholderText)
        local TextBox = Instance.new("TextBox")
        TextBox.Parent = Page
        TextBox.Size = UDim2.new(1, 0, 0, 35)
        TextBox.BackgroundColor3 = Theme.ElementBg
        TextBox.Text = ""
        TextBox.PlaceholderText = placeholderText
        TextBox.TextColor3 = Theme.Text
        TextBox.PlaceholderColor3 = Theme.TextDark
        TextBox.Font = Enum.Font.Gotham
        TextBox.TextSize = 13
        TextBox.ClearTextOnFocus = false
        Instance.new("UICorner", TextBox).CornerRadius = UDim.new(0, 6)

        TextBox.MouseEnter:Connect(function() TweenService:Create(TextBox, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Hover}):Play() end)
        TextBox.MouseLeave:Connect(function() TweenService:Create(TextBox, TweenInfo.new(0.2), {BackgroundColor3 = Theme.ElementBg}):Play() end)
        return TextBox
    end

    function Elements:CreateButton(btnText, callback, customBgColor)
        local baseColor = customBgColor or Theme.ElementBg
        local r = math.clamp(math.floor((baseColor.R * 255) + 20), 0, 255)
        local g = math.clamp(math.floor((baseColor.G * 255) + 20), 0, 255)
        local b = math.clamp(math.floor((baseColor.B * 255) + 20), 0, 255)
        local hoverColor = customBgColor and Color3.fromRGB(r, g, b) or Theme.Hover

        local Btn = Instance.new("TextButton")
        Btn.Parent = Page
        Btn.Size = UDim2.new(1, 0, 0, 35)
        Btn.BackgroundColor3 = baseColor
        Btn.Text = btnText
        Btn.TextColor3 = Theme.Text
        Btn.Font = Enum.Font.GothamBold
        Btn.TextSize = 13
        Btn.AutoButtonColor = false
        Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)

        Btn.MouseEnter:Connect(function() TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = hoverColor}):Play() end)
        Btn.MouseLeave:Connect(function() TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = baseColor}):Play() end)
        
        Btn.MouseButton1Click:Connect(function()
            local rip = Instance.new("Frame")
            rip.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            rip.BackgroundTransparency = 0.8
            rip.Size = UDim2.new(1, 0, 1, 0)
            Instance.new("UICorner", rip).CornerRadius = UDim.new(0, 6)
            rip.Parent = Btn
            local ripTween = TweenService:Create(rip, TweenInfo.new(0.3), {BackgroundTransparency = 1, Size = UDim2.new(1.1, 0, 1.5, 0)})
            ripTween:Play()
            ripTween.Completed:Connect(function() rip:Destroy() end)
            if callback then callback() end
        end)
        return Btn
    end

    function Elements:CreateMusicRow(btnText, musicId, callback, targetFavTab)
        local Row = Instance.new("Frame")
        Row.Parent = Page
        Row.Size = UDim2.new(1, 0, 0, 35)
        Row.BackgroundTransparency = 1

        local MainBtn = Instance.new("TextButton")
        MainBtn.Parent = Row
        MainBtn.Size = UDim2.new(1, -40, 1, 0)
        MainBtn.BackgroundColor3 = Theme.ElementBg
        MainBtn.Text = btnText
        MainBtn.TextColor3 = Theme.Text
        MainBtn.Font = Enum.Font.Gotham
        MainBtn.TextSize = 13
        MainBtn.AutoButtonColor = false
        Instance.new("UICorner", MainBtn).CornerRadius = UDim.new(0, 6)

        local HeartBtn = Instance.new("TextButton")
        HeartBtn.Parent = Row
        HeartBtn.Size = UDim2.new(0, 35, 1, 0)
        HeartBtn.Position = UDim2.new(1, -35, 0, 0)
        HeartBtn.BackgroundColor3 = Theme.ElementBg
        HeartBtn.Font = Enum.Font.Gotham
        HeartBtn.TextSize = 16
        HeartBtn.AutoButtonColor = false
        Instance.new("UICorner", HeartBtn).CornerRadius = UDim.new(0, 6)

        MainBtn.MouseEnter:Connect(function() TweenService:Create(MainBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Hover}):Play() end)
        MainBtn.MouseLeave:Connect(function() TweenService:Create(MainBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.ElementBg}):Play() end)
        HeartBtn.MouseEnter:Connect(function() TweenService:Create(HeartBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Hover}):Play() end)
        HeartBtn.MouseLeave:Connect(function() TweenService:Create(HeartBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.ElementBg}):Play() end)

        MainBtn.MouseButton1Click:Connect(function()
            local rip = Instance.new("Frame")
            rip.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            rip.BackgroundTransparency = 0.8
            rip.Size = UDim2.new(1, 0, 1, 0)
            Instance.new("UICorner", rip).CornerRadius = UDim.new(0, 6)
            rip.Parent = MainBtn
            local ripTween = TweenService:Create(rip, TweenInfo.new(0.3), {BackgroundTransparency = 1, Size = UDim2.new(1.1, 0, 1.5, 0)})
            ripTween:Play()
            ripTween.Completed:Connect(function() rip:Destroy() end)
            if callback then callback() end
        end)

        local isFav = SavedFavorites[musicId] == true
        local favButtonRef = nil

        if isFav then
            HeartBtn.Text = "❌"
            if targetFavTab then
                favButtonRef = targetFavTab:CreateButton(btnText, callback)
            end
        else
            HeartBtn.Text = "❤️"
        end

        HeartBtn.MouseButton1Click:Connect(function()
            isFav = not isFav
            if isFav then
                HeartBtn.Text = "❌"
                SavedFavorites[musicId] = true
                SaveFavoritesToFile()
                if targetFavTab then
                    favButtonRef = targetFavTab:CreateButton(btnText, callback)
                end
            else
                HeartBtn.Text = "❤️"
                SavedFavorites[musicId] = nil
                SaveFavoritesToFile()
                if favButtonRef then
                    favButtonRef:Destroy()
                    favButtonRef = nil
                end
            end
        end)

        return Row
    end

    return Elements
end

