        return
    end
    task.spawn(restore)
end)

bind(CloseBtn.MouseButton1Click, function()
    alive = false
    local fade = TweenService:Create(Main, openInfo, { Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1 })
    fade:Play()
    fade.Completed:Wait()
    for _, conn in ipairs(connections) do
        conn:Disconnect()
    end
    HanzGui:Destroy()
    if loadingGui.Parent then
        loadingGui:Destroy()
    end
end)

-- Jangan buka jendela sebelum loading selesai, biar tidak numpuk.
task.wait(3)

if alive and Main.Parent then
    TweenService:Create(Main, openInfo, { Size = targetSize }):Play()
    local fadeInfo = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(loadingBg, fadeInfo, { BackgroundTransparency = 1 }):Play()
    TweenService:Create(loadingTitle, fadeInfo, { TextTransparency = 1 }):Play()
    TweenService:Create(loadingSub, fadeInfo, { TextTransparency = 1 }):Play()
    TweenService:Create(barTrack, fadeInfo, { BackgroundTransparency = 1 }):Play()
    TweenService:Create(barFill, fadeInfo, { BackgroundTransparency = 1 }):Play()
    task.delay(0.5, function()
        if loadingGui.Parent then
            loadingGui:Destroy()
        end
    end)
end
