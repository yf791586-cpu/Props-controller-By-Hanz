local SaveFileName = "HanzGui_Favorites.json"
local SavedFavorites = {}

pcall(function()
    if isfile and isfile(SaveFileName) then
        local decoded = HttpService:JSONDecode(readfile(SaveFileName))
        if type(decoded) == "table" then
            SavedFavorites = decoded
        end
    end
end)

local function saveFavorites()
    pcall(function()
        if writefile then
            writefile(SaveFileName, HttpService:JSONEncode(SavedFavorites))
        end
    end)
end

local function isFav(id)
    local value = SavedFavorites[tostring(id)]
    return value ~= nil and value ~= false
end

