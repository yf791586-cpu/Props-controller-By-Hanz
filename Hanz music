local function minimize()
    local shrink = TweenService:Create(Main, openInfo, { Size = UDim2.fromOffset(0, 0) })
    shrink:Play()
    shrink.Completed:Wait()
    if not alive then
        return
    end
    Main.Visible = false
    Bubble.Visible = true
    TweenService:Create(Bubble, openInfo, { Size = UDim2.fromOffset(58, 58) }):Play()
end

local function restore()
    local hide = TweenService:Create(Bubble, openInfo, { Size = UDim2.fromOffset(0, 0) })
    hide:Play()
    hide.Completed:Wait()
    if not alive then
        return
    end
    Bubble.Visible = false
    Main.Visible = true
    TweenService:Create(Main, openInfo, { Size = targetSize }):Play()
end

