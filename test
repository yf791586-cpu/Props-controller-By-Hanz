local HttpService = game:GetService("HttpService")
local TextChatService = game:GetService("TextChatService")

-- URL Webhook dari Termux kamu (hasil tunnel)
local myApiUrl = "https://xxxx.loclx.io/webhook"

local function sendToMyServer(sender, message)
    local data = {
        sender = sender,
        message = message
    }
    
    pcall(function()
        request({
            Url = myApiUrl,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json"
            },
            Body = HttpService:JSONEncode(data)
        })
    end)
end

-- Deteksi chat baru (contoh sederhana)
TextChatService.MessageReceived:Connect(function(textChatMessage)
    if textChatMessage.TextSource then
        sendToMyServer(textChatMessage.TextSource.Name, textChatMessage.Text)
    end
end)
