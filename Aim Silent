local function getGunPart()
    local char = localPlayer.Character
    if not char then return nil, nil end

    local tool = char:FindFirstChild("Twist of Fate")
    if not tool then return nil, nil end

    local remoteArg = nil
    local rightArm = tool:FindFirstChild("Right Arm")

    -- 1. Cek Cepat untuk Skin Standar / Emperor (Tanpa Loop)
    if rightArm then
        remoteArg = rightArm:FindFirstChild("gun") or rightArm:FindFirstChild("EmperorGun")
    end
    if not remoteArg then
        remoteArg = tool:FindFirstChild("gun") or tool:FindFirstChild("EmperorGun")
    end

    -- 2. Cek Model/Part tidak bernama di Right Arm (Hanya 1 Level agar tidak lag)
    if not remoteArg and rightArm then
        for _, child in ipairs(rightArm:GetChildren()) do
            if child:IsA("Model") or child:IsA("BasePart") then
                remoteArg = child
                break
            end
        end
    end

    -- 3. Jika tidak ada apa-apa, gunakan Tool langsung (Skin ke-3)
    if not remoteArg then
        remoteArg = tool
    end

    -- 4. CARI TITIK AWAL GARIS (Wajib BasePart fisik, bukan Model agar tidak ERROR)
    local visualPart = nil
    if remoteArg and remoteArg:IsA("BasePart") then
        visualPart = remoteArg
    elseif remoteArg and remoteArg:IsA("Model") and remoteArg.PrimaryPart then
        visualPart = remoteArg.PrimaryPart
    else
        -- Aman: Jadikan Lengan Karakter / Dada Karakter asli sebagai patokan visual tembakan
        visualPart = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightHand") or char:FindFirstChild("HumanoidRootPart")
    end

    return remoteArg, visualPart
end

local function getKillerCharacter()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Team and tostring(p.Team) == "Killer" then
            local char = p.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
                if char:FindFirstChildOfClass("Humanoid").Health > 0 then return char end
            end
        end
    end
    return nil
end

local function getTeamColor(player) return player.Team and player.TeamColor.Color or Color3.fromRGB(255, 255, 255) end

local function checkKillerIsCarrying(char)
    if not char then return false end
    if char:GetAttribute("IsCarrying") == true then return true end
    local val = char:FindFirstChild("IsCarrying")
    if val and val:IsA("ValueBase") and val.Value == true then return true end
    return false
end

