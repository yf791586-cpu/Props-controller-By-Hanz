local function isNearCancelButton(inputPosition)
    local playerGui = localPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    local survivorMob = playerGui:FindFirstChild("Survivor-mob")
    local controls = survivorMob and survivorMob:FindFirstChild("Controls")
    local guiMob = controls and controls:FindFirstChild("Gui-mob")
    local cancelBtn = guiMob and guiMob:FindFirstChild("cancelaim")
    if not cancelBtn then return false end

    local absPos = cancelBtn.AbsolutePosition; local absSize = cancelBtn.AbsoluteSize; local inset, _ = GuiService:GetGuiInset()
    local x = inputPosition.X; local y = inputPosition.Y - inset.Y; local hitToleransi = 35 
    
    return x >= (absPos.X - hitToleransi) and x <= (absPos.X + absSize.X + hitToleransi) and
           y >= (absPos.Y - hitToleransi) and y <= (absPos.Y + absSize.Y + hitToleransi)
end

local function tryFire()
    if not getgenv().SilentAimEnabled then return end

    local myChar = localPlayer.Character
    if not myChar then return end
    if myChar:GetAttribute("Knock") == true or myChar:GetAttribute("IsHooked") == true then return end
    
    local humanoid = myChar:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 30 then return end

    local remoteArg, gunVisualPart = getGunPart()
    local killerChar = getKillerCharacter()
    
    if remoteArg and gunVisualPart and killerChar then
        local killerRoot = killerChar:FindFirstChild("HumanoidRootPart")
        if not killerRoot then return end

        local direction = (killerRoot.Position - gunVisualPart.Position).Unit
        
        pcall(function()
            remote:FireServer(remoteArg, direction)
        end)
    end
end

table.insert(connections, UserInputService.InputEnded:Connect(function(input)
