local function clearESP(player)
    if espCache[player] then
        if espCache[player].Highlight then espCache[player].Highlight:Destroy() end
        if espCache[player].DotContainer then espCache[player].DotContainer:Destroy() end
        espCache[player] = nil
    end
end
table.insert(connections, Players.PlayerRemoving:Connect(clearESP))

local function updateAllESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == localPlayer then continue end
        local char = p.Character
        local rootPart = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local isAlive = rootPart and hum and hum.Health > 0
        local isKiller = p.Team and tostring(p.Team) == "Killer"
        
        if not isAlive or (isKiller and not getgenv().KillerESPEnabled) or (not isKiller and not getgenv().TeamESPEnabled) then clearESP(p); continue end
        
        if not espCache[p] then espCache[p] = {} end
        local tColor = getTeamColor(p)
        
        if isKiller then
            if espCache[p].DotContainer then espCache[p].DotContainer:Destroy(); espCache[p].DotContainer = nil end
            if not espCache[p].Highlight or espCache[p].Highlight.Parent ~= char then
                if espCache[p].Highlight then espCache[p].Highlight:Destroy() end
                local hl = Instance.new("Highlight")
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; hl.Adornee = char; hl.Parent = char
                espCache[p].Highlight = hl
            end
            local hl = espCache[p].Highlight; hl.Enabled = true
            local isKillerCarrying = checkKillerIsCarrying(char)
            if isKillerCarrying then
                hl.FillColor = Color3.fromRGB(0, 140, 255); hl.OutlineColor = Color3.fromRGB(0, 140, 255); hl.FillTransparency = 0; hl.OutlineTransparency = 0
            else
                hl.FillColor = Color3.fromRGB(255, 30, 30); hl.OutlineColor = Color3.fromRGB(255, 30, 30); hl.FillTransparency = 0.5; hl.OutlineTransparency = 0
            end
        else
            if espCache[p].Highlight then espCache[p].Highlight:Destroy(); espCache[p].Highlight = nil end
            if not espCache[p].DotContainer or espCache[p].DotContainer.Parent ~= rootPart then
                if espCache[p].DotContainer then espCache[p].DotContainer:Destroy() end
                local bgui = Instance.new("BillboardGui")
                bgui.AlwaysOnTop = true; bgui.Size = UDim2.new(0, 30, 0, 30); bgui.Adornee = rootPart
                local frame = Instance.new("Frame")
                frame.Size = UDim2.new(0, 14, 0, 14); frame.AnchorPoint = Vector2.new(0.5, 0.5); frame.Position = UDim2.new(0.5, 0, 0.5, 0); frame.BorderSizePixel = 0; frame.Parent = bgui
                Instance.new("UICorner", frame).CornerRadius = UDim.new(1, 0)
                local stroke = Instance.new("UIStroke", frame); stroke.Thickness = 1.5; stroke.Color = Color3.new(0, 0, 0)
                bgui.Parent = rootPart
                espCache[p].DotContainer = bgui; espCache[p].DotFrame = frame
            end
            if espCache[p].DotFrame then
                espCache[p].DotFrame.BackgroundColor3 = tColor
                if camera then
                    local dist = (camera.CFrame.Position - rootPart.Position).Magnitude
                    local clampedSize = math.clamp(math.floor(250 / math.max(dist, 5)), 4, 16)
                    espCache[p].DotFrame.Size = UDim2.new(0, clampedSize, 0, clampedSize)
                end
            end
        end
    end
end

local function stopAimLine()
    isHoldingButton = false
    if linePart then linePart:Destroy(); linePart = nil end
end

local function startAimLine()
    if not getgenv().SilentAimEnabled then return end
    stopAimLine()
    isHoldingButton = true
    linePart = Instance.new("Part"); linePart.Anchored = true; linePart.CanCollide = false; linePart.CanTouch = false; linePart.CanQuery = false
    linePart.Material = Enum.Material.Neon; linePart.Color = Color3.fromRGB(255, 30, 30); linePart.Transparency = 0.3; linePart.Parent = workspace
end

local renderConn = RunService.RenderStepped:Connect(function()
    updateAllESP() 
    if isHoldingButton and linePart then
        local killerChar = getKillerCharacter()
        local _, gunVisualPart = getGunPart()
        local myChar = localPlayer.Character
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        
        local isKnocked = myChar and myChar:GetAttribute("Knock") == true
        local isHooked = myChar and myChar:GetAttribute("IsHooked") == true

        if not getgenv().SilentAimEnabled or not killerChar or not gunVisualPart or (myHum and myHum.Health <= 30) or isKnocked or isHooked then
            stopAimLine(); return
        end

        local killerPos = killerChar.HumanoidRootPart.Position
        local startPos = gunVisualPart.Position
        local distance = (killerPos - startPos).Magnitude
        if distance < 0.1 then distance = 0.1 end

        linePart.Transparency = 0.3
        linePart.Size = Vector3.new(0.15, 0.15, distance)
        linePart.CFrame = CFrame.lookAt(startPos, killerPos) * CFrame.new(0, 0, -distance / 2)
    end
end)
table.insert(connections, renderConn)

