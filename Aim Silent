getgenv().TwistOfFateCleanup = function()
    getgenv().ScriptActive = false; stopAimLine(); activeInputObj = nil
    if sg then sg:Destroy() end
    for p, _ in pairs(espCache) do clearESP(p) end; espCache = {}
    for _, conn in ipairs(connections) do
        if conn and conn.Connected then conn:Disconnect() end
    end
    connections = {}
end
